# Database (PostgreSQL with pgvector)
DB_HOST=your-postgres-host
DB_PORT=5432
DB_NAME=open_brain
DB_USER=open_brain
DB_PASSWORD=generate-a-secure-password

# Standard libpq vars, so `psql` and other Postgres clients connect with NO
# arguments. The app reads DB_* above; psql does not, and bare psql defaults to
# a database named after your user. Duplicating the values is deliberate: two
# consumers, two spellings. Keep in sync with DB_* above.
PGHOST=your-postgres-host
PGPORT=5432
PGDATABASE=open_brain
PGUSER=open_brain

# Embedding service (OpenAI-compatible /v1/embeddings endpoint)
EMBEDDING_BASE_URL=http://your-embedding-host:8791/v1
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_MODEL=embeddinggemma-300m-8bit
# Must match the DB schema (halfvec(768) columns) -- changing this requires a column migration + re-embed
EMBEDDING_DIMENSIONS=768
EMBEDDING_WATCHDOG_FAILURE_THRESHOLD=2
EMBEDDING_WATCHDOG_COOLDOWN_MS=300000
# Optional: executable script to run after repeated embedding provider failures
EMBEDDING_WATCHDOG_RESTART_SCRIPT=
# Optional: consumed by scripts/restart-mlx-embedding-server.sh when used as the watchdog restart script.
MLX_EMBED_DAEMON=
MLX_EMBED_RUNTIME_DIR=
MLX_EMBED_PORT=8791
MLX_EMBED_HEALTH_URL=http://127.0.0.1:8791/health
MLX_EMBED_CURL=
MLX_EMBED_HEALTH_RETRIES=20
MLX_EMBED_HEALTH_SLEEP_SECONDS=1
MLX_EMBED_RESTART_SETTLE_SECONDS=2
MLX_EMBED_RESTART_LOCK_STALE_AFTER_SECONDS=300

# Server
PORT=3100
OPEN_BRAIN_BIND_HOST=
OPENBRAIN_LOCAL_CLONE=0
OPENBRAIN_LOCAL_CLONE_ROOT=
# Local clone mode requires an explicit empty QMD_PATH to disable the production default:
# QMD_PATH=
# Optional operator-doctor override for the qmd SQLite index location:
# QMD_INDEX_PATH=
DB_POOL_MAX=10
OPEN_BRAIN_RUN_MIGRATIONS=1
# Raw turns nearing this TTL trigger operator-doctor distillation lag alarms.
# Retention/eviction is implemented separately by issue #395.
OPENBRAIN_RAW_TURN_TTL_SECONDS=604800

# Optional operator opt-in for the public search_brain default.
# Non-English keyword/hybrid FTS recomputes tsvectors on the fly and is not index-backed.
# OPENBRAIN_FTS_CONFIG=german

# Server call tracing to Langfuse (#530) -- CONTENT-FUL, off by default.
# Every MCP tool call becomes one trace carrying full arguments and full
# results, with detector matches replaced before egress. Requires ALL FOUR:
# the flag set to exactly "1" plus the three
# coordinates, or the lane stays off and logs one content-free warn naming the
# missing one. Keys come from the operator environment (Vaultwarden item
# "Langfuse - Open Brain Local Dogfood") -- NEVER put values here.
# Read once at startup, so changing these needs a service restart.
# ENDPOINT is the Langfuse server ROOT (the SDK appends its own OTLP path),
# not the /api/public/ingestion URL the #372 lane posts to.
# If Langfuse goes down the brain is unaffected and that window's traces are
# dropped -- one "suspended" warn on the way down, one "resumed" info with the
# drop count on the way back, never one per call.
# See docs/CONFIG_REFERENCE.md "Server call tracing (#530)".
OPENBRAIN_TRACING_ENABLED=0
# Default is on. Set exactly "0" only for an explicit operator-approved bypass.
OPENBRAIN_TRACING_MASKING_ENABLED=1
OPENBRAIN_TRACING_ENDPOINT=
OPENBRAIN_TRACING_PUBLIC_KEY=
OPENBRAIN_TRACING_SECRET_KEY=

# CORS allowed origins (comma-separated, empty for none)
ALLOWED_ORIGINS=

# Auth tokens -- one per consumer role
# Generate with: openssl rand -hex 32
AUTH_TOKEN_ADMIN=generate-a-secure-token
AUTH_TOKEN_AGENT=generate-a-secure-token
AUTH_TOKEN_DISCORD=generate-a-secure-token
AUTH_TOKEN_READONLY=generate-a-secure-token
AUTH_TOKEN_OB_ADMIN=generate-a-secure-token
AUTH_TOKEN_PROMOTER=generate-a-secure-token
