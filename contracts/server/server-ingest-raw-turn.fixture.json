{
  "id": "server-ingest-raw-turn",
  "description": "Ingest user and assistant turns through the current-src writer.",
  "capability": "raw-turn-ingest-server",
  "providers": [
    "current-src",
    "server-rewrite-scaffold"
  ],
  "auth": {
    "role": "agent",
    "client_id": "parity-raw-turn",
    "namespace_source": "token"
  },
  "steps": [
    {
      "tool": "ingest_raw_turn",
      "arguments": {
        "turns": [
          {
            "turn_uuid": "11111111-1111-4111-8111-111111111111",
            "turn_index": 0,
            "role": "user",
            "content": "What behavior is frozen?"
          },
          {
            "turn_uuid": "22222222-2222-4222-8222-222222222222",
            "turn_index": 1,
            "role": "assistant",
            "content": "The observed current-src contract."
          }
        ]
      },
      "expectation": {
        "is_error": false,
        "json": {
          "ingested": 2,
          "duplicates": 0,
          "filtered": 0,
          "namespace": "{{namespace}}"
        }
      }
    }
  ]
}
