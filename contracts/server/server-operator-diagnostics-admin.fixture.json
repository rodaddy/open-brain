{
  "id": "server-operator-diagnostics-admin",
  "description": "Freeze the operator_doctor payload IDENTITY for an admin identity: the doctor contract version and its section shape. Environment-dependent values (migration counts, provider reachability, pool numbers) are deliberately not asserted -- those are facts about the machine the suite runs on, and freezing them would record an accident of this database rather than the contract.",
  "capability": "operator-diagnostics",
  "providers": [
    "current-src",
    "server-rewrite-scaffold"
  ],
  "auth": {
    "role": "admin",
    "client_id": "parity-operator-diagnostics-admin",
    "namespace_source": "token"
  },
  "steps": [
    {
      "tool": "operator_doctor",
      "arguments": {},
      "expectation": {
        "is_error": false,
        "json": {
          "contract_version": "2026-08-05.operator-doctor.v4",
          "generated_at": "<iso-date>",
          "runtime": {
            "service": "open-brain",
            "version": "<non-empty-string>",
            "contract_version": "2026-08-09.memory-tools.v24",
            "contract_schema_version": 1
          },
          "embedding_provider": {
            "model": "<non-empty-string>",
            "dimensions": 768
          }
        }
      }
    }
  ]
}
