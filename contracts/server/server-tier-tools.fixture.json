{
  "id": "server-tier-tools",
  "description": "Freeze tier mutation no-op, batch count, recommendation, and lane dry-run shapes.",
  "capability": "tier-tools",
  "providers": [
    "current-src",
    "server-rewrite-scaffold"
  ],
  "auth": {
    "role": "agent",
    "client_id": "parity-tier",
    "namespace_source": "token"
  },
  "steps": [
    {
      "tool": "set_tier",
      "arguments": {
        "table": "thoughts",
        "id": "33333333-3333-4333-8333-333333333333",
        "tier": "hot"
      },
      "expectation": {
        "is_error": true,
        "text": "Entry not found or archived"
      }
    },
    {
      "tool": "bulk_set_tier",
      "arguments": {
        "entries": [
          {
            "table": "thoughts",
            "id": "44444444-4444-4444-8444-444444444444",
            "tier": "cold"
          }
        ]
      },
      "expectation": {
        "is_error": false,
        "json": {
          "requested": 1,
          "updated": 0
        }
      }
    },
    {
      "tool": "tier_recommendations",
      "arguments": {
        "action": "promote"
      },
      "expectation": {
        "is_error": false,
        "json": {
          "action": "promote",
          "threshold_days": 7,
          "candidates_found": 0,
          "candidates": []
        }
      }
    },
    {
      "tool": "tier_lane",
      "arguments": {
        "session_key": "parity/tier",
        "dry_run": true
      },
      "expectation": {
        "is_error": false,
        "json": {
          "session_key": "parity/tier",
          "namespace": "{{namespace}}",
          "scanned": 0,
          "graduated": 0,
          "kept": 0,
          "archived": 0,
          "manual_review": 0,
          "duplicates": 0,
          "dry_run": true
        }
      }
    }
  ]
}
