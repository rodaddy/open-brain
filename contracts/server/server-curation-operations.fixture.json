{
  "id": "server-curation-operations",
  "description": "Freeze empty and not-found shapes for curation discovery, archival, promotion, and demotion tools.",
  "capability": "curation-operations",
  "providers": [
    "current-src",
    "server-rewrite-scaffold"
  ],
  "auth": {
    "role": "admin",
    "client_id": "parity-curation-ops",
    "namespace_source": "token"
  },
  "steps": [
    {
      "tool": "archive_entry",
      "arguments": {
        "table": "thoughts",
        "id": "55555555-5555-4555-8555-555555555555"
      },
      "expectation": {
        "is_error": false,
        "text": "Already archived or not found"
      }
    },
    {
      "tool": "bulk_archive",
      "arguments": {
        "entries": [
          {
            "table": "thoughts",
            "id": "66666666-6666-4666-8666-666666666666"
          }
        ]
      },
      "expectation": {
        "is_error": false,
        "json": {
          "requested": 1,
          "archived": 0
        }
      }
    },
    {
      "tool": "scan_namespace",
      "arguments": {
        "namespace": "{{namespace}}",
        "target_namespace": "{{namespace}}",
        "table": "thoughts"
      },
      "expectation": {
        "is_error": false,
        "json": {
          "namespace": "{{namespace}}",
          "target_namespace": "{{namespace}}",
          "candidates": [],
          "duplicates": [],
          "summary": {
            "candidates": 0,
            "duplicates": 0
          }
        }
      }
    },
    {
      "tool": "promote_entry",
      "arguments": {
        "table": "thoughts",
        "id": "77777777-7777-4777-8777-777777777777",
        "target_namespace": "{{namespace}}",
        "dry_run": true
      },
      "expectation": {
        "is_error": true,
        "text": "Source entry not found or archived"
      }
    },
    {
      "tool": "demote_entry",
      "arguments": {
        "table": "thoughts",
        "id": "88888888-8888-4888-8888-888888888888"
      },
      "expectation": {
        "is_error": true,
        "text": "Entry not found or already archived"
      }
    }
  ]
}
