#!/usr/bin/env zsh
set -eu

# Open Brain pre-push gate.
# Preserve the existing full validation and add path-sensitive Python/parity gates.
# The repo holds TWO Python packages: python/openbrain-memory and python/openbrain.
# Each is gated on its own paths with its own validation, so a push touching only
# one still runs that one's mypy/ruff/pytest -- a push touching only
# python/openbrain used to skip every Python check entirely.

echo "pre-push: running Open Brain validation..."

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Single source of truth for the parity path filter; CI and the PR-body
# workflow read the same file, and check-parity.ts asserts it is non-empty.
PARITY_PATHS=("${(f)$(cat "$ROOT/contracts/parity-paths.txt")}")

ZERO_SHA=0000000000000000000000000000000000000000
SAW_RANGE=no
CHANGED_PYTHON=no
CHANGED_OPENBRAIN=no
CHANGED_PARITY=no

while read -r _local_ref local_sha _remote_ref remote_sha; do
  SAW_RANGE=yes
  if [ "$local_sha" = "$ZERO_SHA" ]; then
    continue
  fi
  if [ "$remote_sha" = "$ZERO_SHA" ]; then
    if git rev-parse --verify origin/main >/dev/null 2>&1; then
      base_sha="$(git merge-base "$local_sha" origin/main)"
    elif git rev-parse --verify main >/dev/null 2>&1; then
      base_sha="$(git merge-base "$local_sha" main)"
    else
      base_sha="$(git hash-object -t tree /dev/null)"
    fi
  else
    base_sha="$remote_sha"
  fi

  if [ -n "$(git diff --name-only "$base_sha" "$local_sha" -- python/openbrain-memory)" ]; then
    CHANGED_PYTHON=yes
  fi
  # `python/openbrain` is a distinct path from `python/openbrain-memory`: a git
  # pathspec matches whole path components, so this leading-dir filter never
  # catches the sibling package. Each package gets its own gate on its own paths.
  if [ -n "$(git diff --name-only "$base_sha" "$local_sha" -- python/openbrain)" ]; then
    CHANGED_OPENBRAIN=yes
  fi
  if [ -n "$(git diff --name-only "$base_sha" "$local_sha" -- "${PARITY_PATHS[@]}")" ]; then
    CHANGED_PARITY=yes
  fi
done

# A direct/manual invocation has no pre-push stdin. Compare the current branch
# to main so local hook testing retains useful behavior.
if [ "$SAW_RANGE" = no ]; then
  if git rev-parse --verify origin/main >/dev/null 2>&1; then
    BASE="$(git merge-base HEAD origin/main)"
  elif git rev-parse --verify main >/dev/null 2>&1; then
    BASE="$(git merge-base HEAD main)"
  else
    BASE="HEAD^"
  fi
  if [ -n "$(git diff --name-only "$BASE" HEAD -- python/openbrain-memory)" ]; then
    CHANGED_PYTHON=yes
  fi
  if [ -n "$(git diff --name-only "$BASE" HEAD -- python/openbrain)" ]; then
    CHANGED_OPENBRAIN=yes
  fi
  if [ -n "$(git diff --name-only "$BASE" HEAD -- "${PARITY_PATHS[@]}")" ]; then
    CHANGED_PARITY=yes
  fi
fi

echo "  bun run typecheck ..."
bun run typecheck
echo "  ✓ TypeScript passed"

echo "  bun test ..."
bun test
echo "  ✓ Bun tests passed"

if [ "$CHANGED_PYTHON" = yes ]; then
  echo "  Python package changed; running Python validation ..."
  (
    cd python/openbrain-memory
    echo "    uv run mypy src/openbrain_memory ..."
    uv run mypy src/openbrain_memory
    echo "    ✓ mypy passed"

    echo "    uv run ruff check src tests ..."
    uv run ruff check src tests
    echo "    ✓ ruff passed"

    echo "    uv run pytest -q ..."
    uv run pytest -q
    echo "    ✓ pytest passed"
  )
else
  echo "  Python package unchanged; skipping Python package gate"
fi

if [ "$CHANGED_OPENBRAIN" = yes ]; then
  echo "  openbrain package changed; running openbrain validation ..."
  (
    cd python/openbrain
    echo "    uv run mypy src/openbrain ..."
    uv run mypy src/openbrain
    echo "    ✓ mypy passed"

    echo "    uv run ruff check src tests ..."
    uv run ruff check src tests
    echo "    ✓ ruff passed"

    echo "    uv run pytest -q ..."
    uv run pytest -q
    echo "    ✓ pytest passed"

    echo "    uv run generate_package_docs --check ..."
    uv run python ../../scripts/pytools/generate_package_docs.py --check --path src/openbrain
    echo "    ✓ package docs in sync"
  )
else
  echo "  openbrain package unchanged; skipping openbrain package gate"
fi

if [ "$CHANGED_PARITY" = yes ]; then
  echo "  Client/contract paths changed; running contract parity subset ..."
  bun contracts/check-parity.ts
  (
    cd python/openbrain-memory
    uv run pytest -q tests/test_contract_fixtures.py
  )
  echo "  ✓ Contract parity passed"
else
  echo "  Client/contract paths unchanged; skipping contract parity subset"
fi

echo "pre-push: all checks passed ✓"
