#!/opt/homebrew/bin/bash
# commit-msg -- enforce Conventional Commits on the message itself.
#
# This hook exists because one of the repos this standard came from had NO
# commit-msg hook at all while three documents described commit format as
# enforced. The format was aspirational; nothing read it.
#
# Argument $1 is the path to the file holding the proposed message. Rewriting
# that file changes the commit; this hook only reads it.

set -uo pipefail

msg_file="$1"
[[ -f "$msg_file" ]] || exit 0

# First non-comment, non-empty line is the subject.
subject="$(grep -v '^#' "$msg_file" | grep -v '^[[:space:]]*$' | head -1)"

# A merge or revert is generated by git and is not the author's to format.
case "$subject" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

fail() {
  printf '\n[commit-msg] BLOCKED: %s\n\n' "$1"
  printf '  Your subject:\n    %s\n\n' "$subject"
  printf '  Required: <type>(<scope>)?: <description>\n'
  printf '    types: feat fix docs style refactor perf test build ci chore revert\n'
  printf '    - imperative mood ("add", not "added" or "adds")\n'
  printf '    - no trailing period\n'
  printf '    - subject <= 72 chars\n\n'
  printf '  Examples:\n'
  printf '    feat(monitor): add exponential backoff to the check loop\n'
  printf '    fix(config): honour EXEMPLAR_PORTS__BASE over the JSON file\n\n'
  exit 1
}

[[ -n "$subject" ]] || fail "empty commit message"

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
if ! [[ "$subject" =~ ^(${types})(\([a-z0-9._/-]+\))?!?:\ .+ ]]; then
  fail "subject does not match Conventional Commits"
fi

if [[ ${#subject} -gt 72 ]]; then
  fail "subject is ${#subject} chars (limit 72)"
fi

if [[ "$subject" =~ \.$ ]]; then
  fail "subject ends with a period"
fi

# Past tense is the most common drift and reads wrong in a changelog, which is
# generated from these lines.
desc="${subject#*: }"
first_word="${desc%% *}"
case "$first_word" in
  added|fixed|updated|removed|changed|adds|fixes|updates|removes|changes)
    fail "description starts with '$first_word' -- use imperative ('add', 'fix')"
    ;;
esac

exit 0
