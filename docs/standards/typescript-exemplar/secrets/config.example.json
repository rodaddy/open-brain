{
  "env": "dev",
  "logging": {
    "level": "debug",
    "file": "logs/exemplar.log",
    "pretty": true
  },
  "database": {
    "path": "data/history.db"
  },
  "ports": {
    "base": 715
  },
  "monitor": {
    "intervalSeconds": 60,
    "targets": [
      {
        "name": "example",
        "url": "https://example.test/health",
        "intervalSeconds": 30,
        "timeoutMs": 5000,
        "expectStatus": [200],
        "failureThreshold": 3
      }
    ]
  },
  "hook": {
    "forwardUrl": null,
    "signingSecret": null
  },
  "watch": {
    "paths": ["data"],
    "debounceMs": 250
  }
}
