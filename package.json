{
  "name": "open-brain",
  "version": "0.9.0",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "start:two-worker": "bun run scripts/run-two-worker.ts",
    "migrate": "bun run scripts/migrate.ts",
    "db": "bun run --env-file=.env scripts/db.ts",
    "sync-issues": "bun run scripts/sync-issues.ts",
    "test": "bun test",
    "test:isolated": "bun run scripts/test-isolated.ts",
    "typecheck": "bunx tsc --noEmit",
    "backfill": "bun run scripts/backfill.ts",
    "codex-memory-smoke": "bun run scripts/codex-memory-smoke.ts",
    "eval:memory": "bun run scripts/eval-open-brain-memory.ts",
    "eval:live": "bun run scripts/eval-open-brain-live.ts",
    "eval:scenarios": "bun run scripts/eval-open-brain-scenarios.ts",
    "eval:reflex-ab": "bun run eval/open-brain/live/reflex-ab-cli.ts",
    "import-kb": "bun run scripts/import-legacy-kb.ts",
    "promote:legacy-shared": "bun run scripts/promote-legacy-shared.ts",
    "promote:qmd-facts": "bun run scripts/promote-qmd-repo-facts.ts",
    "curate": "bun run scripts/curate.ts",
    "distill": "bun run scripts/distill-run.ts",
    "dream:cycle": "bun run scripts/dream-cycle.ts",
    "dream:light": "bun run scripts/dream-light-run.ts",
    "dream:rem": "bun run scripts/dream-rem-run.ts",
    "dream:deep": "bun run scripts/dream-deep-run.ts",
    "grade": "bun run scripts/grading-server-run.ts",
    "deploy:core01": "/opt/homebrew/bin/bash scripts/core01-deploy-local.sh",
    "qmd:core01:bootstrap": "/opt/homebrew/bin/bash scripts/core01-qmd-bootstrap.sh",
    "sample:grade": "bun run --env-file=.env scripts/grading-sample.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.18.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@langfuse/core": "^4.6.1",
    "@langfuse/otel": "^4.6.1",
    "@langfuse/tracing": "^4.6.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.0.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "nats": "^2.29.3",
    "pg": "^8.20.0",
    "pgvector": "^0.2.1",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "zod": "^4.3.6"
  }
}
