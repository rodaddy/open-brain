+/**
+ * Live-Postgres coverage for the issue #604 remediation apply path.
+ *
+ * Gated on OPENBRAIN_TEST_DATABASE_URL because the conflict target, transaction
+ * isolation, partial unique index, and JSONB source_refs behavior are decisions
+ * made by Postgres rather than by the TypeScript planner.
+ */
+import { afterAll, afterEach, beforeAll, describe, expect, it } from "bun:test";
+import { Pool } from "pg";
+import { runMigrations } from "../src/db/migrate.ts";
+import { contentHash } from "../src/embedding.ts";
+import {
+  applyTargets,
+  dryRunReceipt,
+  readTargets,
+} from "./decompose-oversize-thoughts.ts";
+
+const DB_URL = process.env.OPENBRAIN_TEST_DATABASE_URL;
+const dbDescribe = DB_URL ? describe : describe.skip;
+const TEST_NAMESPACE = "issue-604-remediation-pg-test";
+const TEST_ACTOR = "issue-604-remediation-pg-test";
+const TARGET_SOURCE = "planning-skippy-agentspace";
+
+function transcript(marker: string, records = 120): string {
+  return Array.from({ length: records }, (_, index) =>
+    JSON.stringify({
+      type: index % 2 === 0 ? "user" : "assistant",
+      uuid: `${marker}-${index}`,
+      sessionId: marker,
+      message: { role: "user", content: `${marker} ${"x".repeat(80)}` },
+    }),
+  ).join("\n");
+}
+
+function repeatedTranscript(records = 120): string {
+  const shell = JSON.stringify({
+    type: "user",
+    uuid: "repeat",
+    sessionId: "repeat",
+    message: { role: "user", content: "" },
+  });
+  const padding = 199 - shell.length;
+  if (padding < 1) throw new Error("repeated transcript fixture is too large");
+  const line = JSON.stringify({
+    type: "user",
+    uuid: "repeat",
+    sessionId: "repeat",
+    message: { role: "user", content: "x".repeat(padding) },
+  });
+  if (line.length !== 199) {
+    throw new Error(`repeated transcript line must be 199 chars, got ${line.length}`);
+  }
+  return Array.from({ length: records }, () => line).join("\n");
+}
+
+dbDescribe("decompose-oversize-thoughts apply path (live Postgres)", () => {
+  let pool: Pool;
+
+  beforeAll(async () => {
+    pool = new Pool({ connectionString: DB_URL });
+    await pool.query("CREATE EXTENSION IF NOT EXISTS vector");
+    await runMigrations(pool);
+    await cleanup();
+  });
+
+  afterEach(cleanup);
+
+  afterAll(async () => {
+    await cleanup();
+    await pool.end();
+  });
+
+  async function cleanup(): Promise<void> {
+    await pool.query("DELETE FROM discarded_entries WHERE namespace = $1", [
+      TEST_NAMESPACE,
+    ]);
+    await pool.query("DELETE FROM thoughts WHERE namespace = $1", [
+      TEST_NAMESPACE,
+    ]);
+  }
+
+  async function seedTarget(content: string): Promise<string> {
+    const { rows } = await pool.query<{ id: string }>(
+      `INSERT INTO thoughts (content, created_by, namespace, source, tier)
+       VALUES ($1, $2, $3, $4, 'warm')
+       RETURNING id`,
+      [content, TEST_ACTOR, TEST_NAMESPACE, TARGET_SOURCE],
+    );
+    return rows[0]!.id;
+  }
+
+  async function activePieces(): Promise<Array<Record<string, unknown>>> {
+    const { rows } = await pool.query(
+      `SELECT id, content, parent_id, chunk_index, source_refs
+         FROM thoughts
+        WHERE namespace = $1
+          AND source = 'issue-604-transcript-decomposition'
+          AND archived_at IS NULL
+        ORDER BY id`,
+      [TEST_NAMESPACE],
+    );
+    return rows;
+  }
+
+  it("reports skipped oversized rows and reuse-resolved dry-run pieces", async () => {
+    const targetId = await seedTarget(transcript("dry-run-reuse"));
+    await seedTarget("oversized prose without transcript records ".repeat(100));
+    const initialScan = await readTargets(pool, TEST_NAMESPACE);
+    const target = initialScan.targets.find((item) => item.row.id === targetId);
+    expect(target).toBeDefined();
+    const reused = target!.decomposition.proposed_replacements[0]!;
+    await pool.query(
+      `INSERT INTO thoughts (content, content_hash, created_by, namespace)
+       VALUES ($1, $2, $3, $4)`,
+      [reused.content, contentHash(reused.content), TEST_ACTOR, TEST_NAMESPACE],
+    );
+
+    const scan = await readTargets(pool, TEST_NAMESPACE);
+    const receipt = (await dryRunReceipt(pool, scan)) as {
+      skipped_oversized_count: number;
+      total_proposed_pieces: number;
+      total_planned_pieces: number;
+      total_reuse_resolved_pieces: number;
+    };
+
+    expect(receipt.skipped_oversized_count).toBe(1);
+    expect(receipt.total_reuse_resolved_pieces).toBe(1);
+    expect(receipt.total_planned_pieces).toBeLessThan(
+      receipt.total_proposed_pieces,
+    );
+  });
+
+  it("is a no-op when apply is run a second time", async () => {
+    const originalId = await seedTarget(transcript("idempotent"));
+    const firstScan = await readTargets(pool, TEST_NAMESPACE);
+    const first = await applyTargets(pool, firstScan.targets);
+
+    expect(first).toHaveLength(1);
+    expect(first[0]?.status).toBe("applied");
+    const pieceCount = (await activePieces()).length;
+    expect(pieceCount).toBeGreaterThan(1);
+
+    const secondScan = await readTargets(pool, TEST_NAMESPACE);
+    const second = await applyTargets(pool, secondScan.targets);
+
+    expect(secondScan.targets).toHaveLength(0);
+    expect(second).toEqual([]);
+    expect(await activePieces()).toHaveLength(pieceCount);
+    const lifecycle = await pool.query(
+      "SELECT archived_at FROM thoughts WHERE id = $1",
+      [originalId],
+    );
+    expect(lifecycle.rows[0]?.archived_at).not.toBeNull();
+  });
+
+  it("skips an archived hash collision and commits the other target", async () => {
+    const blockedId = await seedTarget(transcript("blocked"));
+    const healthyId = await seedTarget(transcript("healthy"));
+    const scan = await readTargets(pool, TEST_NAMESPACE);
+    const blocked = scan.targets.find((target) => target.row.id === blockedId);
+    expect(blocked).toBeDefined();
+    const collisionPiece = blocked!.decomposition.proposed_replacements[0]!;
+    await pool.query(
+      `INSERT INTO thoughts
+         (content, content_hash, created_by, namespace, archived_at)
+       VALUES ($1, $2, $3, $4, NOW())`,
+      [
+        collisionPiece.content,
+        contentHash(collisionPiece.content),
+        TEST_ACTOR,
+        TEST_NAMESPACE,
+      ],
+    );
+
+    const results = await applyTargets(pool, scan.targets);
+    const blockedResult = results.find(
+      (result) => result.original_id === blockedId,
+    );
+    const healthyResult = results.find(
+      (result) => result.original_id === healthyId,
+    );
+
+    expect(blockedResult).toMatchObject({
+      status: "skipped",
+      reason: "archived_hash_collision",
+      planned_pieces: 0,
+    });
+    expect(healthyResult?.status).toBe("applied");
+    const originals = await pool.query(
+      "SELECT id, archived_at FROM thoughts WHERE id = ANY($1::uuid[]) ORDER BY id",
+      [[blockedId, healthyId]],
+    );
+    const archivedById = new Map(
+      originals.rows.map((row) => [row.id as string, row.archived_at]),
+    );
+    expect(archivedById.get(blockedId)).toBeNull();
+    expect(archivedById.get(healthyId)).not.toBeNull();
+  });
+
+  it("dedupes identical chunks with coherent refs and receipt counts", async () => {
+    const originalId = await seedTarget(repeatedTranscript());
+    const scan = await readTargets(pool, TEST_NAMESPACE);
+    const results = await applyTargets(pool, scan.targets);
+    const result = results[0];
+
+    expect(result?.status).toBe("applied");
+    if (!result || result.status !== "applied") return;
+    expect(result.intra_batch_duplicate_pieces).toBeGreaterThan(0);
+    expect(
+      result.planned_pieces +
+        result.reuse_resolved_pieces +
+        result.intra_batch_duplicate_pieces,
+    ).toBe(result.proposed_pieces);
+    expect(result.piece_ids).toHaveLength(result.proposed_pieces);
+
+    const pieces = await activePieces();
+    expect(pieces).toHaveLength(result.written_ids.length);
+    for (const piece of pieces) {
+      const refs = piece.source_refs as Array<Record<string, unknown>>;
+      expect(refs.length).toBeLessThanOrEqual(25);
+      expect(refs).toContainEqual(
+        expect.objectContaining({ document_id: originalId }),
+      );
+    }
+  });
+
+  it("adds a source_ref when another original reuses an existing chunk", async () => {
+    const content = transcript("cross-original");
+    const firstId = await seedTarget(content);
+    const firstScan = await readTargets(pool, TEST_NAMESPACE);
+    const first = await applyTargets(pool, firstScan.targets);
+    expect(first[0]?.status).toBe("applied");
+
+    const secondId = await seedTarget(content);
+    const secondScan = await readTargets(pool, TEST_NAMESPACE);
+    const second = await applyTargets(pool, secondScan.targets);
+    const result = second.find((item) => item.original_id === secondId);
+    expect(result?.status).toBe("applied");
+    if (!result || result.status !== "applied") return;
+    expect(result.reuse_resolved_pieces).toBeGreaterThan(0);
+
+    const pieces = await activePieces();
+    const linked = pieces.filter((piece) => {
+      const refs = piece.source_refs as Array<Record<string, unknown>>;
+      return refs.some((ref) => ref.document_id === secondId);
+    });
+    expect(linked.length).toBeGreaterThan(0);
+    expect(
+      linked.some((piece) =>
+        (piece.source_refs as Array<Record<string, unknown>>).some(
+          (ref) =>
+            ref.document_id === secondId &&
+            typeof ref.section === "string" &&
+            ref.section.startsWith("chunk:"),
+        ),
+      ),
+    ).toBe(true);
+    expect(firstId).not.toBe(secondId);
+  });
+});
